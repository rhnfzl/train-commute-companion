# Copy separately to config/household/alice/.env and config/household/bob/.env.
# Replace both placeholders. Create a DIFFERENT Telegram bot for each traveller.
# Use the primary key of the NS-App product. See docs/ns-api-key.md.
NS_API_KEY=replace-with-your-ns-app-primary-key
# Optional personal KNMI Open Data API key for official weather warnings. Forecasts need none.
KNMI_API_KEY=
TELEGRAM_BOT_TOKEN=replace-with-this-travellers-bot-token
# Leave blank to open this companion's private setup link or scan its terminal QR.
# Press Start. The chosen chat persists in this companion's /data.
# Links expire after 15 minutes; restart an unclaimed companion for a new link.
# Keep setup logs private. Set a positive private ID only for a manual override.
TELEGRAM_CHAT_ID=
# Optional and disabled while blank. Use a separate secret for each traveller.
OWNTRACKS_SECRET=
# Optional override, 16+ printable ASCII characters without spaces.
# Blank auto-generates a private /data/health-token in this companion's volume.
# Its own log prints the token once. Restarts reuse it for full health and Today access.
TCC_HEALTH_TOKEN=
# Optional private calendar token for this companion only. Use openssl rand -hex 32.
TCC_CALENDAR_TOKEN=
# Optional planned-works look-ahead time, HH:MM in Europe/Amsterdam.
TCC_LOOKAHEAD_AT=06:00
# SMTP and webhook delivery are off. Add settings only to their owner's private file.
