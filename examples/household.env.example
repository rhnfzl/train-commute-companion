# Copy separately to config/household/alice/.env and config/household/bob/.env.
# Replace both placeholders. Create a DIFFERENT Telegram bot for each traveller.
NS_API_KEY=replace-with-an-ns-api-key
TELEGRAM_BOT_TOKEN=replace-with-this-travellers-bot-token
# Start blank, send this bot a private message, then use the id in its own log.
TELEGRAM_CHAT_ID=
# Optional and disabled while blank. Generate different secrets for each traveller.
OWNTRACKS_SECRET=
TCC_HEALTH_TOKEN=
TCC_LOOKAHEAD_AT=06:00
# SMTP and webhook delivery are off. Add settings only to their owner's private file.
