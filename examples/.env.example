# Copy to .env next to docker-compose.yml. Keep that file private and out of Git.
# Required: use the primary key of the NS-App product, not the subscription ID.
# https://github.com/rhnfzl/train-commute-companion/blob/main/docs/ns-api-key.md
NS_API_KEY=replace-with-your-ns-app-primary-key
# Optional personal KNMI Open Data API key for official weather warnings. Forecasts need none.
KNMI_API_KEY=
# Required: create a bot with BotFather and use its token.
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
# Optional manual override. Blank prints a private setup link and terminal QR.
# Open it and press Start. The chosen private chat persists in /data.
# Links expire after 15 minutes; restart an unclaimed app for a new link.
# Keep setup logs private. Group and channel IDs are refused.
TELEGRAM_CHAT_ID=
# Optional override, 16+ printable ASCII characters without spaces.
# Blank automatically creates /data/health-token and logs it once for setup.
# Restarts reuse it. This token grants full health and Today access to all profiles.
TCC_HEALTH_TOKEN=
# Optional: enable OwnTracks with a separate secret, 16+ printable ASCII, no spaces.
OWNTRACKS_SECRET=
# Optional planned-works look-ahead time, HH:MM in Europe/Amsterdam.
TCC_LOOKAHEAD_AT=06:00
# Optional container paths. Keep /data on a persistent writable volume.
# TCC_PROFILES=/config/profiles.yaml
# TCC_STATE_DIR=/data
# Optional webhook copies: URLs separated by spaces or commas.
# TCC_WEBHOOK_URLS=
# TCC_WEBHOOK_SECRET=replace-with-a-separate-secret-at-least-16-characters
# TCC_WEBHOOK_TOKEN=
# Optional email copies: see docs/email.md before enabling.
# SMTP_HOST=
# SMTP_SECURITY=starttls
# SMTP_PORT=587
# SMTP_FROM=
# SMTP_TO=
# SMTP_USERNAME=
# SMTP_PASSWORD=
